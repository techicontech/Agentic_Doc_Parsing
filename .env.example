# LiteLLM proxy (required)
# All chat + vision/OCR traffic goes through this OpenAI-compatible endpoint.
LITELLM_API_BASE=https://YOUR-LITELLM-HOST/v1
LITELLM_API_KEY=
LLM_MODEL=claude-haiku

# Diagram / plate OCR: claude | mistral | skip
OCR_BACKEND=claude
OCR_VISION_MODEL=claude-haiku
# Only required when OCR_BACKEND=mistral
MISTRAL_OCR_MODEL=mistral/mistral-ocr-latest

# Docling layout/table parse (use cuda when NVIDIA + CUDA torch available)
DOCLING_DEVICE=cuda
DOCLING_ENABLED=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=marine_docs
POSTGRES_USER=marine
POSTGRES_PASSWORD=marine_dev

# MinIO (S3-compatible figure store)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=marine-figures
MINIO_SECURE=false
